// Cloudflare Worker that serves the Next.js app through the OpenNext adapter.
// Build: pnpm --filter web cf:build   Deploy: pnpm --filter web cf:deploy
// NEXT_PUBLIC_* values are inlined at build time: Workers Builds build variables (dashboard).
// Do not create apps/web/.env.production.local: `next build` would then point local e2e at that project.
// SUPABASE_SECRET_KEY is a Worker secret set by the owner: pnpm --filter web exec wrangler secret put SUPABASE_SECRET_KEY
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zeespare-web",
  "main": ".open-next/worker.js",
  // Public website domains belong to Cloudflare Pages; legacy maqdar.org is retired.
  "routes": [
    { "pattern": "ote.zeespare.com", "custom_domain": true },
    { "pattern": "acme.zeespare.com", "custom_domain": true },
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://zeespare.com",
    "OTE_ORGANIZATION_ID": "49727e18-35a9-462f-998f-9f202f963dfc",
    "ACME_ORGANIZATION_ID": "2cd8944d-52a1-45e2-9230-6f4fd0a2c6d4",
  },
  // Cloudflare dropped the compressed Worker size limit on 2026-09-04. Minify stays because a smaller
  // script parses and starts faster. wrangler deploy --dry-run "Total Upload" gzipped, unminified /
  // minified: 3.21 / 2.81 MiB at Step 4, 3.72 / 3.27 MiB with the Step 5a import wizard (measured
  // with wrangler 4.149.0; SheetJS in the server bundle is about 156 KiB of that).
  "minify": true,
  // Keep application execution near the Supabase database in AWS Mumbai.
  "placement": { "region": "aws:ap-south-1" },
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "zeespare-web",
    },
  ],
  "observability": {
    "enabled": true,
  },
  // Workers Rate Limiting for /api/v1 (src/lib/api/bindings.ts, declared in cloudflare-env.d.ts).
  // Abuse protection only: counted per Cloudflare location and eventually consistent; the exact caps
  // (one write per organization, recorded writes per day, record and body caps) live in Postgres.
  // `period` must be 10 or 60. `ratelimits` is not inherited by wrangler environments: repeat it in
  // each one. namespace_id values must be unused in the account (confirmed by the owner).
  "ratelimits": [
    { "name": "API_KEY_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "API_IP_LIMITER", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } },
  ],
}
