// Cloudflare Worker that serves the Next.js app through the OpenNext adapter.
// Build: pnpm --filter web cf:build   Deploy: pnpm --filter web cf:deploy
// NEXT_PUBLIC_* values are inlined at build time: Workers Builds build variables (dashboard).
// Do not create apps/web/.env.production.local: `next build` would then point local e2e at that project.
// SUPABASE_SECRET_KEY is a Worker secret set by the owner: pnpm --filter web exec wrangler secret put SUPABASE_SECRET_KEY
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maqdar-web",
  "main": ".open-next/worker.js",
  // Cloudflare dropped the compressed Worker size limit on 2026-09-04. Minify stays because a smaller
  // script parses and starts faster. wrangler deploy --dry-run "Total Upload" gzipped, unminified /
  // minified: 3.21 / 2.81 MiB at Step 4, 3.72 / 3.27 MiB with the Step 5a import wizard (measured
  // with wrangler 4.149.0; SheetJS in the server bundle is about 156 KiB of that).
  "minify": true,
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "maqdar-web",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
