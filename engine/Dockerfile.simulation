# Verified official Linux/amd64 CPython 3.12.15 image, locked by digest.
FROM python:3.12.15-slim-bookworm@sha256:2ed6491b93cd49272ee6de2b5a38440c3448360322c089fc23e370722d74179d AS builder
COPY --from=ghcr.io/astral-sh/uv:0.12.23 /uv /usr/local/bin/uv
ENV UV_PYTHON_DOWNLOADS=never UV_LINK_MODE=copy
WORKDIR /app/engine
COPY engine/pyproject.toml engine/uv.lock engine/README.md ./
COPY engine/src ./src
RUN uv sync --locked --no-dev --no-editable

FROM python:3.12.15-slim-bookworm@sha256:2ed6491b93cd49272ee6de2b5a38440c3448360322c089fc23e370722d74179d
RUN useradd --create-home --uid 10001 worker
WORKDIR /app
COPY --from=builder /app/engine/.venv /app/engine/.venv
COPY engine/container-entrypoint.py /app/container-entrypoint.py
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
USER worker
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=30s CMD ["/app/engine/.venv/bin/python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=2)"]
CMD ["/app/engine/.venv/bin/python", "/app/container-entrypoint.py"]
